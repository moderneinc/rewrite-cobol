LPAREN : '(';
RPAREN : ')';
COMMA : ',';
SEMI : ';';
DOT : '.';
COLON : ':';
STAR : '*';
PLUS : '+';
MINUS : '-';
SLASH : '/';
CONCAT_OP : '||';
EQ : '=';
NEQ : '<>' | '!=' | '^=';
