GTE : '>=';
LT : '<';
GT : '>';
QUESTION : '?';

STRING : '\'' (~['\r\n] | '\'\'')* '\'';
HEX_STRING : 'X' '\'' [0-9A-F ]* '\'';
DELIMITED_IDENTIFIER : '"' (~["\r\n] | '""')* '"';

// The DDL on disk is a template: genapp writes <DB2DBID>.customer, Bank-of-Z {{ db2.sqlid }} and
// GenevaERS the JCL symbolic &$DBNAME. Lexing a placeholder as a name is what keeps the CREATE
// TABLE around it readable. Bounded to a bare word so that `x < 5` is still two tokens.
// A symbolic's trailing dot ends the name rather than qualifying it, so &SYSUID.S is one name and
// &SYSUID..TABLE is a name, a qualifier dot and another name.
PLACEHOLDER : '<' [A-Z0-9_.]+ '>' | '{{' ~[}\r\n]* '}}' | '&' [A-Z0-9_@#$]+ ('.' [A-Z0-9_@#$]*)?;

NUMBER : [0-9]+ ('.' [0-9]+)? (('E') ('+' | '-')? [0-9]+)?;
IDENTIFIER : [A-Z_@#$] [A-Z0-9_@#$]*;
HOST_VARIABLE : ':' [A-Z_@#$] [A-Z0-9_@#$\-.]*;
